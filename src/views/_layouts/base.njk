<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {# Le titre de la page est défini dans chaque page,
         avec un fallback sur config.titre #}
    <title>
      {% if title %}
        {{ title }}
        —
      {% endif %}
      {{ config.titre }}
    </title>
    <link rel="stylesheet" href="{{ '/assets/styles/main.css' | url }}" />
  </head>
  <body>
    {# Le contenu de chaque page est injecté ici #}
    {{ content | safe }}
    <section>
      <footer id="contact">
        <article class="footer-animation">
          <h4 class="footer-title">eikonlab</h4>
          <div class="footer-track">
            <h4>eikonlab</h4>
            <h4>eikonlab</h4>
            <h4>eikonlab</h4>
            <h4>eikonlab</h4>
            <h4>eikonlab</h4>
            <h4>eikonlab</h4>
            <h4>eikonlab</h4>
            <h4>eikonlab</h4>
            <h4>eikonlab</h4>
          </div>
        </article>
        <article class="footer-contact">
          <h2>contact</h2>
          <div class="footer-contact-copyright">
            <div class="footer-contact-info">
              <p>eikon_lab@edufr.ch<br />+41 26 305 46 96</p>
              <p>Rte des Arsenaux 41<br />1700 Fribourg<br />Suisse</p>
              <a href="https://eikon.ch/" target="_blank">
                <p>eikon.ch</p>
              </a>
            </div>
            <div class="footer-bottom-all">
              <div class="footer-director">
                <a
                  href="https://giulia-cariulo.ch/"
                  target="_blank"
                  class="hover-box"
                  ><p>Giulia Cariulo</p>
                  <div class="box">
                    <img
                      src="../../public/images/Fetish-Giulia.webp"
                      alt="l'icone de giulia"
                    /></div
                ></a>
                <a
                  href="http://amelie-rako.ch/"
                  target="_blank"
                  class="hover-box"
                >
                  <p>Amélie Rakowiecki</p>
                  <div class="box">
                    <img
                      src="../../public/images/Fetish-Amelie.webp"
                      alt="le portrait d'amelie"
                    />
                  </div>
                </a>
                <a
                  href="https://camille-magnin.ch/"
                  target="_blank"
                  class="hover-box"
                  ><p>Camille Magnin</p>
                  <div class="box">
                    <img
                      src="../../public/images/Fetish-Camille.webp"
                      alt="le chat de camille"
                    /></div
                ></a>
              </div>
              <p class="footer-copyright">
                © eikonlab 2026, tous droits réservés.
              </p>
            </div>
          </div>
        </article>
      </footer>
    </section>

    <script type="module" src="{{ '/assets/js/main.js' | url }}"></script>
    {% block scripts %}{% endblock %}
  </body>
</html>
