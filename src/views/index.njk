---
layout: base.njk
title: Accueil
permalink: "/"
---

{# ============================================================
   index.njk — Page d'accueil
   Toutes les variables ci-dessous sont injectées automatiquement
   par Eleventy depuis les fichiers dans src/_data/ :
     - config        → config.json
     - projets       → projets.js (lit le dossier projets/)
     - encadrants    → encadrants.json  (variable = objet entier)
     - interns       → interns.json     (variable = objet entier)
   ============================================================ #}
<h1>Index aka Homepage</h1>
<a href="{{ '/projets/ecole-de-couture/' | url }}"
  >Écriture du permalink utilisé dans ce projet</a
>

{# ============================================================
   Exemple : Liste des projets (variable `projets`)
   `projets` est un tableau injecté par src/_data/projets.js,
   qui lit tous les fichiers JSON du dossier src/_data/projets/.
   ============================================================ #}
{% if projets and projets.length %}
  <section class="projets">
    {% for projet in projets %}
      <article class="projet">

        {# Image de couverture #}
        {% if projet.cover_image %}
          <img src="{{ projet.cover_image }}" alt="{{ projet.titre }}">
        {% endif %}

        {# Titre + lien vers la page du projet #}
        <h2>
          <a href="{{ ('/projets/' + projet.id + '/') | url }}">{{ projet.titre }}</a>
        </h2>

        {# Type de mandat #}
        <p>{{ projet.type }}</p>

        {# Sessions (tableau de strings) #}
        {% if projet.sessions and projet.sessions.length %}
          <p>Sessions : {{ projet.sessions | join(', ') }}</p>
        {% endif %}

        {# Client·e·s (tableau de strings) #}
        {% if projet.clients and projet.clients.length %}
          <p>Client·e·s : {{ projet.clients | join(', ') }}</p>
        {% endif %}

        {# Tags (tableau de strings) #}
        {% if projet.tags and projet.tags.length %}
          <ul class="tags">
            {% for tag in projet.tags %}
              <li>{{ tag }}</li>
            {% endfor %}
          </ul>
        {% endif %}

        {# Description #}
        <p>{{ projet.description }}</p>

        {# Compétences mises en œuvre #}
        {% if projet.competences %}
          <p>Compétences : {{ projet.competences }}</p>
        {% endif %}

        {# Autres images (tableau de {fichier, legende}) #}
        {% if projet.images and projet.images.length %}
          <ul class="images">
            {% for image in projet.images %}
              <li>
                <figure>
                  <img src="{{ image.fichier }}" alt="{{ image.legende or '' }}">
                  {% if image.legende %}
                    <figcaption>{{ image.legende }}</figcaption>
                  {% endif %}
                </figure>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        {# Liens (tableau de {label, url}) #}
        {% if projet.liens and projet.liens.length %}
          <ul class="liens">
            {% for lien in projet.liens %}
              <li>
                <a href="{{ lien.url }}" target="_blank">{{ lien.label }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

      </article>
    {% endfor %}
  </section>
{% endif %}

{# ============================================================
   Exemple : Portfolio (config.portfolio)
   Chaque entrée est soit une image (item.media.fichier),
   soit une phrase/citation (item.quote).
   ============================================================ #}
{% if config.portfolio and config.portfolio.length %}
  <section class="portfolio">
    {% for item in config.portfolio %}
      {% if item.media and item.media.fichier %}
        <figure>
          <img src="{{ item.media.fichier }}" alt="{{ item.media.legende or '' }}">
          {% if item.media.legende %}
            <figcaption>{{ item.media.legende }}</figcaption>
          {% endif %}
        </figure>
      {% elif item.quote %}
        <blockquote>
          <p>{{ item.quote }}</p>
        </blockquote>
      {% endif %}
    {% endfor %}
  </section>
{% endif %}
