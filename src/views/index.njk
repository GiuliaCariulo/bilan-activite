{# ============================================================
   index.njk — Page d'accueil
   Variables injectées par Eleventy depuis src/_data/ :
     - config        → config.json
     - projets       → projets.js
     - encadrants    → encadrants.json
     - stagiaires    → stagiaires.json
   ============================================================ #}

{# ============================================================
   HERO — Grille d'accueil (27 cellules sur 5 rangées de 8 colonnes)
   ============================================================

   "cases" décrit, dans l'ordre, le contenu de chaque cellule de la
   grille. loop.index donne sa position (1 à 27), utilisée en CSS
   via [data-pos="N"] pour le placement (grid-column: span X, etc.)

   Types de cases :
     - "img"        → image placeholder (portfolio / projets)
     - "eikonlab"   → titre de section
     - "mot"        → mot du directeur (ouvre hero-grid-expand-r2)
     - "sessions"   → titre de section
     - "edito"      → avant-propos (ouvre hero-grid-expand-r3)
     - "bilan"      → titre "Bilan d'activité"
     - "priorites"  → priorités eikonlab (ouvre hero-grid-expand-r4)
     - "annee"      → année scolaire
     - "encadrants" → titre de section (span 3)
     - "partenaires"→ titre de section
#}
{% set cases = [
  "img", "img", "img", "img", "img",
  "eikonlab", "img", "mot", "img", "sessions",
  "img", "edito", "img", "img", "img", "bilan",
  "img", "img", "priorites", "img", "img", "annee",
  "encadrants", "img", "img", "partenaires"
] %}

<div class="hero-grid">

  {% for case in cases %}
    {% if case == "img" %}
      {# Placeholder image — sera remplacé par une vraie image de projet #}
      <img class="hero-grid-cell hero-grid-cell-img" data-pos="{{ loop.index }}" alt="image"></img>

    {% elif case == "eikonlab" %}
      <div class="hero-grid-cell hero-grid-cell-eikonlab" data-pos="{{ loop.index }}">
        eikonlab
      </div>
  
    {% elif case == "mot" %}
      {# Cellule cliquable → ouvre hero-grid-expand-r2 (mot du directeur) #}
      <div
        class="hero-grid-cell hero-grid-cell-mot"
        data-pos="{{ loop.index }}"
        data-row="r2"
      >
        mot du directeur
      </div>

    {% elif case == "sessions" %}
      <div class="hero-grid-cell hero-grid-cell-sessions" data-pos="{{ loop.index }}">
        sessions
      </div>

    {% elif case == "edito" %}
      {# Cellule cliquable → ouvre hero-grid-expand-r3 (avant-propos / édito) #}
      <div
        class="hero-grid-cell hero-grid-cell-edito"
        data-pos="{{ loop.index }}"
        data-row="r3"
      >
        edito
      </div>

    {% elif case == "bilan" %}
      <div class="hero-grid-cell hero-grid-cell-bilan" data-pos="{{ loop.index }}">
        Bilan d'activité
      </div>

    {% elif case == "priorites" %}
      {# Cellule cliquable → ouvre hero-grid-expand-r4 (priorités) #}
      <div
        class="hero-grid-cell hero-grid-cell-priorites"
        data-pos="{{ loop.index }}"
        data-row="r4"
      >
        priorités
      </div>

    {% elif case == "annee" %}
      <div class="hero-grid-cell hero-grid-cell-annee" data-pos="{{ loop.index }}">
        25/26
      </div>

    {% elif case == "encadrants" %}
      <div class="hero-grid-cell hero-grid-cell-encadrants" data-pos="{{ loop.index }}">
        encadrant.e.s
      </div>

    {% elif case == "partenaires" %}
      <div class="hero-grid-cell hero-grid-cell-partenaires" data-pos="{{ loop.index }}">
        partenaires
      </div>
    {% endif %}
  {% endfor %}

  {# ── EXPAND r2 : mot du directeur ──────────────────────────── #}
  <div class="hero-grid-expand hero-grid-expand-r2">
    <div class="hero-grid-expand-sizer">
      <div class="hero-grid-expand-content">
        <div class="hero-grid-expand-left">
          {# Le texte est injecté dynamiquement en JS depuis DATA #}
          <p class="hero-grid-expand-text"></p>
        </div>
        <p class="hero-grid-expand-signature"></p>
      </div>
    </div>
  </div>

  {# ── EXPAND r3 : édito / avant-propos ──────────────────────── #}
  <div class="hero-grid-expand hero-grid-expand-r3">
    <div class="hero-grid-expand-sizer">
      <div class="hero-grid-expand-content">
        <div class="hero-grid-expand-left">
          <p class="hero-grid-expand-text"></p>
          <p class="hero-grid-expand-text-suite"></p>
          <button class="hero-grid-voir-plus">voir plus...</button>
          <button class="hero-grid-voir-moins" style="display: none">
            voir moins...
          </button>
        </div>
        <p class="hero-grid-expand-signature"></p>
      </div>
    </div>
  </div>

  {# ── EXPAND r4 : priorités (rempli dynamiquement en JS) ────── #}
  <div class="hero-grid-expand hero-grid-expand-r4">
    <div class="hero-grid-expand-sizer">
      <div class="hero-grid-expand-content"></div>
    </div>
  </div>

</div>

{# ============================================================
   Données injectées pour le JS du hero (voir assets/js/main.js)
   On expose ici les textes longs venant de config.json, lus par
   le script via window.HERO_DATA.
   ============================================================ #}
<script>
  window.HERO_DATA = {
    "hero-grid-cell-mot": {
      row: "r2",
      text: {{ config.intro_directeur | markdown | safe | dump }},
      textSuite: null,
      signature: "Felix Kaufmann, directeur d'eikon",
    },
    "hero-grid-cell-edito": {
      row: "r3",
      text: {{ config.intro_edito | markdown | safe | dump }},
      textSuite: null,
      signature: "l'équipe eikonlab",
    },
    "hero-grid-cell-priorites": {
      row: "r4",
      items: [
        {% for priorite in config.priorites %}
          { titre: {{ priorite.titre | dump }}, texte: {{ priorite.texte | dump }} }{% if not loop.last %},{% endif %}
        {% endfor %}
      ],
      signature: null,
    },
  };
</script>


<section>
  <h2>Mot du directeur</h2>
  {# Champ texte long : on utilise | nl2br pour respecter les sauts de ligne #}
  <p>{{ config.intro_directeur | markdown | safe }}</p>
</section>

<section>
  <h2>Avant-propos</h2>
  <p>{{ config.intro_edito | markdown | safe }}</p>

  {# Priorités : liste, on vérifie qu'elle n'est pas vide avant d'afficher #}
  {% if config.priorites and config.priorites.length %}
    <h3>Les priorités pour eikonlab</h3>
    <ol>
      {% for priorite in config.priorites %}
        <li>{{ priorite }}</li>
      {% endfor %}
    </ol>
  {% endif %}
</section>

{# ── MÉDIAS GÉNÉRAUX ─────────────────────────────────────────── #}
{# Condition : on n'affiche la section que si le tableau contient au moins un élément #}
{% if config.medias and config.medias.length %}
  <section>
    <h2>Médias</h2>
    <div>
      {% for media in config.medias %}
        <figure>
          <img src="{{ media.fichier | url }}" alt="{{ media.legende }}" />
          {# Condition : légende affichée uniquement si elle existe #}
          {% if media.legende %}
            <figcaption>{{ media.legende }}</figcaption>
          {% endif %}
        </figure>
      {% endfor %}
    </div>
  </section>
{% endif %}

{# ── PROJETS ─────────────────────────────────────────────────── #}
<section>
  <h2>Projets</h2>
  <ul>
    {% for projet in projets %}
      {% include "carte-projet.njk" %}
    {% endfor %}
  </ul>
</section>

{# ── ÉQUIPE : encadrants ─────────────────────────────────────── #}
{# encadrants.encadrants : le fichier encadrants.json a la clé "encadrants" à la racine #}
{% if encadrants.encadrants and encadrants.encadrants.length %}
  <section>
    <h2>Encadrant·es</h2>
    <ul>
      {% for encadrant in encadrants.encadrants %}
        <li>
          {# Condition : photo affichée uniquement si le champ est renseigné #}
          {% if encadrant.photo %}
            <img src="{{ encadrant.photo }}" alt="{{ encadrant.nom }}" />
          {% endif %}

          <strong>{{ encadrant.nom }}</strong>

          {% if encadrant.titre %}
            <span>{{ encadrant.titre }}</span>
          {% endif %}

          {# Condition : secteurs affichés uniquement si la liste est non vide #}
          {% if encadrant.secteurs and encadrant.secteurs.length %}
            <ul>
              {% for secteur in encadrant.secteurs %}
                <li>{{ secteur }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </section>
{% endif %}

{# ── ÉQUIPE : stagiaires par session ─────────────────────────── #}
{# interns.aout_decembre / .janvier_avril / .avril_juillet
   sont les trois tableaux définis dans interns.json #}
<section>
  <h2>Stagiaires</h2>

  {%
    set sessions = [
      { label: "Août – décembre",  liste: stagiaires.aout_decembre },
      { label: "Janvier – avril",  liste: stagiaires.janvier_avril },
      { label: "Avril – juillet",  liste: stagiaires.avril_juillet }
    ]
  %}

  {% for session in sessions %}
    {# Condition : on n'affiche une session que si elle a au moins un stagiaire #}
    {% if session.liste and session.liste.length %}
      <h3>{{ session.label }}</h3>
      <ul>
        {% for stagiaire in session.liste %}
          <li>
            {% if stagiaire.photo %}
              <img src="{{ stagiaire.photo }}" alt="{{ stagiaire.nom }}" />
            {% endif %}
            {{ stagiaire.nom }}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  {% endfor %}
</section>

{# ── PARTENAIRES ─────────────────────────────────────────────── #}
{% if config.partenaires and config.partenaires.length %}
  <section>
    <h2>Partenaires</h2>
    <ul>
      {% for partenaire in config.partenaires %}
        <li>{{ partenaire }}</li>
      {% endfor %}
    </ul>
  </section>
{% endif %}

{# ── RESSOURCES ──────────────────────────────────────────────── #}
{# Condition : champ texte simple, on vérifie qu'il n'est pas vide #}
{% if config.ressources %}
  <section>
    <h2>Ressources</h2>
    <p>{{ config.ressources | markdown | safe }}</p>
  </section>
{% endif %}

<footer>
  <p>{{ config.organisation }}</p>
</footer>
