{# ============================================================
   Exemple : Sections (variable `sections`)
   `sections` est l'objet injecté par src/_data/sections.json
   (variable = objet entier, donc on boucle sur `sections.sections`).
   `hook` et `text` sont du Markdown (widget: markdown dans le CMS),
   on utilise le filtre `markdown` + `safe` pour les convertir en HTML.
   ============================================================ #}
{% if sections.sections and sections.sections.length %}
  <section class="sections">
    {% for section in sections.sections %}
      <article class="section">
        <h2>{{ section.title }}</h2>
        {% if section.author %}
          <p class="auteur">{{ section.author }}</p>
        {% endif %}
        {% if section.hook %}
          <div class="accroche">{{ section.hook | markdown | safe }}</div>
        {% endif %}
        {% if section.text %}
          <div class="texte">{{ section.text | markdown | safe }}</div>
        {% endif %}
      </article>
    {% endfor %}
  </section>
{% endif %}

