---
layout: base.njk
title: Accueil
permalink: "/"
---

{# ============================================================
   index.njk — Page d'accueil
   Toutes les variables ci-dessous sont injectées automatiquement
   par Eleventy depuis les fichiers dans src/_data/ :
     - config        → config.json
     - projets       → projets.js (lit le dossier projets/)
     - encadrants    → encadrants.json  (variable = objet entier)
     - sections      → sections.json    (variable = objet entier)
     - interns       → interns.json     (variable = objet entier)
   ============================================================ #}
<h1>Index aka Homepage</h1>
<a href="{{ '/projets/ecole-de-couture/' | url }}"
  >Écriture du permalink utilisé dans ce projet</a
>

{# ============================================================
   Exemple : Liste des projets (variable `projets`)
   `projets` est un tableau injecté par src/_data/projets.js,
   qui lit tous les fichiers JSON du dossier src/_data/projets/.
   ============================================================ #}

{% if projets and projets.length %}
  <section class="projets-gallery row">
    <h2 class="projets-gallery-title">projets</h2>
    {% for projet in projets %}
      <a
        href="{{ ('/projets/' + projet.id + '/') | url }}"
        class="projets-gallery-project-card"
        data-pos="{{ loop.index }}"
      >
        <article class="projet">
          {# Image de couverture #}
          {% if projet.thumbnail %}
            <img src="{{ projet.thumbnail }}" alt="{{ projet.title }}" />
          {% endif %}
          <div class="projets-gallery-label">
            {# Titre #}
            <h4>{{ projet.title }}</h4>

            {# Tags (tableau de strings) #}
            {% if projet.tags and projet.tags.length %}
              <ul class="tags">
                {% for tag in projet.tags %}
                  <li>{{ tag }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </article>
      </a>
    {% endfor %}
  </section>
{% endif %}

{# ============================================================
   Exemple : Sections (variable `sections`)
   `sections` est l'objet injecté par src/_data/sections.json
   (variable = objet entier, donc on boucle sur `sections.sections`).
   `hook` et `text` sont du Markdown (widget: markdown dans le CMS),
   on utilise le filtre `markdown` + `safe` pour les convertir en HTML.
   ============================================================ #}
{% if sections.sections and sections.sections.length %}
  <section class="sections">
    {% for section in sections.sections %}
      <article class="section">
        <h2>{{ section.title }}</h2>
        {% if section.author %}
          <p class="auteur">{{ section.author }}</p>
        {% endif %}
        {% if section.hook %}
          <div class="accroche">{{ section.hook | markdown | safe }}</div>
        {% endif %}
        {% if section.text %}
          <div class="texte">{{ section.text | markdown | safe }}</div>
        {% endif %}
      </article>
    {% endfor %}
  </section>
{% endif %}

{# ============================================================
   Exemple : Portfolio (config.portfolio)
   Chaque entrée est soit une image (item.media.fichier),
   soit une phrase/citation (item.quote).
   ============================================================ #}
{% if config.portfolio and config.portfolio.length %}
  <section class="portfolio">
    {% for item in config.portfolio %}
      {% if item.media and item.media.image %}
        <figure>
          <img
            src="{{ item.media.image }}"
            alt="{{ item.media.legend or '' }}"
          />
          {% if item.media.legend %}
            <figcaption>{{ item.media.legend }}</figcaption>
          {% endif %}
        </figure>
      {% elif item.quote %}
        <blockquote>
          <p>{{ item.quote }}</p>
        </blockquote>
      {% endif %}
    {% endfor %}
  </section>
{% endif %}
