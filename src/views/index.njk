{# ============================================================
   index.njk — Page d'accueil
   Toutes les variables ci-dessous sont injectées automatiquement
   par Eleventy depuis les fichiers dans src/_data/ :
     - config        → config.json
     - projets       → projets.js (lit le dossier projets/)
     - encadrants    → encadrants.json  (variable = objet entier)
     - sections      → sections.json    (variable = objet entier)
     - interns       → interns.json     (variable = objet entier)
   ============================================================ #}

{# ============================================================
   HERO — Grille d'accueil (27 cellules sur 5 rangées de 8 colonnes)
   ============================================================

   "cases" décrit, dans l'ordre, le contenu de chaque cellule de la
   grille. loop.index donne sa position (1 à 27), utilisée en CSS
   via [data-pos="N"] pour le placement (grid-column: span X, etc.)

   Types de cases :
     - "img"        → image placeholder (portfolio / projets)
     - "eikonlab"   → titre de section
     - "mot"        → mot du directeur (ouvre hero-grid-expand-r2)
     - "sessions"   → titre de section
     - "edito"      → avant-propos (ouvre hero-grid-expand-r3)
     - "bilan"      → titre "Bilan d'activité"
     - "priorites"  → priorités eikonlab (ouvre hero-grid-expand-r4)
     - "annee"      → année scolaire
     - "encadrants" → titre de section (span 3)
     - "partenaires"→ titre de section
#}
{%
  set cases = [
    "img", "img", "img", "img", "img",
    "eikonlab", "img", "mot", "img", "sessions",
    "img", "edito", "img", "img", "img", "bilan",
    "img", "img", "priorites", "img", "img", "annee",
    "encadrants", "img", "img", "partenaires"
  ]
%}

<div class="hero-grid">
  {% for case in cases %}
    {% if case == "img" %}
      {# Image de projet — src à adapter selon la source de données choisie #}
      <div
        class="hero-grid-cell hero-grid-cell-img"
        data-pos="{{ loop.index }}"
      >
        <img
          src="{{ config.medias[0].fichier | url }}"
          alt="{{ config.medias[0].legende }}"
        />
      </div>
    {% elif case == "eikonlab" %}
      <div
        class="hero-grid-cell hero-grid-cell-eikonlab"
        data-pos="{{ loop.index }}"
      >
        eikonlab
      </div>
    {% elif case == "mot" %}
      {# Cellule cliquable → ouvre hero-grid-expand-r2 (mot du directeur) #}
      <div
        class="hero-grid-cell hero-grid-cell-mot"
        data-pos="{{ loop.index }}"
        data-row="r2"
      >
        mot du directeur
      </div>
    {% elif case == "sessions" %}
      <div
        class="hero-grid-cell hero-grid-cell-sessions"
        data-pos="{{ loop.index }}"
      >
        sessions
      </div>
    {% elif case == "edito" %}
      <div
        class="hero-grid-cell hero-grid-cell-edito"
        data-pos="{{ loop.index }}"
        data-row="r3"
      >
        edito
      </div>
    {% elif case == "bilan" %}
      <div
        class="hero-grid-cell hero-grid-cell-bilan"
        data-pos="{{ loop.index }}"
      >
        Bilan d'activité
      </div>
    {% elif case == "priorites" %}
      {# Cellule cliquable → ouvre hero-grid-expand-r4 (priorités) #}
      <div
        class="hero-grid-cell hero-grid-cell-priorites"
        data-pos="{{ loop.index }}"
        data-row="r4"
      >
        priorités
      </div>
    {% elif case == "annee" %}
      <div
        class="hero-grid-cell hero-grid-cell-annee"
        data-pos="{{ loop.index }}"
      >
        25/26
      </div>
    {% elif case == "encadrants" %}
      <div
        class="hero-grid-cell hero-grid-cell-encadrants"
        data-pos="{{ loop.index }}"
      >
        encadrant.e.s
      </div>
    {% elif case == "partenaires" %}
      <div
        class="hero-grid-cell hero-grid-cell-partenaires"
        data-pos="{{ loop.index }}"
      >
        partenaires
      </div>
    {% endif %}
  {% endfor %}

  {# ── EXPAND r2 : mot du directeur ──────────────────────────── #}
  <div class="hero-grid-expand hero-grid-expand-r2">
    <div class="hero-grid-expand-sizer">
      <div class="hero-grid-expand-content">
        <div class="hero-grid-expand-left">
          <p class="hero-grid-expand-text">{{ config.text }}</p>
        </div>
        <p class="hero-grid-expand-signature">{{ config.director }}</p>
      </div>
    </div>
  </div>

  {# ── EXPAND r3 : édito / avant-propos ──────────────────────── #}
  <div class="hero-grid-expand hero-grid-expand-r3">
    <div class="hero-grid-expand-sizer">
      <div class="hero-grid-expand-content">
        <div class="hero-grid-expand-left">
          <p class="hero-grid-expand-text">En février 2026, eikon a été invitée à participer à une table ronde organisée par l’association YouComm (association des professionnel.les de la communication du canton de Fribourg) sur le thème de l’intelligence artificielle. L’intitulé était Création et IA, la lune de miel est-elle terminée ? Notre intervention a été l’occasion de rappeler que le CFC d’Interactive Media Designer avait pris ses racines sur la formation anciennement intitulée : Concepteur en Multimédia. Loin de remettre en cause la légitimité de l’intitulé actuel, il nous semble important de rappeler que le terme de concepteur reste central dans l’approche professionnelle qui est enseignée à nos élèves, et qu’il va le devenir d’autant plus dans le contexte technologique qui nous est promis – dans un avenir bien plus proche que l’on ne l’aurait imaginé il y a quelque temps. Dans les métiers de la communication et plus généralement de la création, les phases de productions sont effectivement amenées à être modifiées, notamment par différents systèmes d’assistance mis à disposition des professionnels du secteur. Dès lors, le rôle de l’école est d’être attentive aux profils pouvant s’inscrire dans cet environnement de travail en mouvement, tout en gardant un œil critique et en ajustant si besoin l’ordre des priorités. Être capable de concevoir, coordonner et maitriser un projet de communication, tout en ayant une parfaite compréhension des étapes de développement est essentiel pour les élèves, indépendamment du fait qu’ils ou elles s’orientent par la suite dans une hyperspécialisation (frontend, opérateur de caméra, graphiste 3D…) ou préfèrent opter pour une voie plus généraliste (agence de communication par exemple). Développer une vision et savoir piloter les phases opérationnelles doit représenter un acquis prioritaire aux termes des 3 ou 4 années de formation à eikon. Dans ce contexte, eikonLAB a plus que jamais le devoir d’être une opportunité pour notre institution formatrice. La mission pédagogique que nous nous sommes fixée depuis plusieurs années, de renforcer les acquis en termes de méthodologie et de mettre les compétences des élèves de 4ème année au profit de projets technologiquement exploratoires, trouve un écho d’autant plus porteur en 2026. A l’image du code qui ne se fait plus aujourd’hui sans l’assistance d’une IA, les stagiaires doivent ainsi pouvoir faire l’expérience d’un certain nombre de tâches qui vont être « potentiellement » automatisées, mais surtout étudier les enjeux conceptuels et méthodologiques de ce nouveau contexte professionnel. C’est donc dans ce sens que nous avons de nouveau orienté les projets de eikonlab durant cette année scolaire 2025-26, et nous sommes très heureux aujourd’hui de partager avec vous le résultat de ces différentes réalisations. Comme à l’accoutumée, ce document est également l’occasion de transmettre nos plus vifs remerciements à nos partenaires, collaborateurs et prestataires pour la confiance et l’accompagnement qu’ils ou elles accordent aux jeunes professionnel. les de la formation « Interactive Media Designer ». <br> Bonne lecture.</p>
          <p class="hero-grid-expand-text-suite"></p>
          <button class="hero-grid-voir-plus">voir plus...</button>
          <button class="hero-grid-voir-moins" style="display: none">
            voir moins...
          </button>
        </div>
        <p class="hero-grid-expand-signature"></p>
      </div>
    </div>
  </div>

  {# ── EXPAND r4 : priorités (rempli dynamiquement en JS) ────── #}
  <div class="hero-grid-expand hero-grid-expand-r4">
    <div class="hero-grid-expand-sizer">
      <div class="hero-grid-expand-content"></div>
    </div>
  </div>
</div>

{# ============================================================
   Données injectées pour le JS du hero (voir assets/js/main.js)
   On expose ici les textes longs venant de config.json, lus par
   le script via window.HERO_DATA.
   ============================================================ #}

{% if projets and projets.length %}
  <section class="projets">
    {% for projet in projets %}

        {# Image de couverture #}
        {% if projet.thumbnail %}
          <img src="{{ projet.thumbnail }}" alt="{{ projet.title }}">
        {% endif %}

        {# Titre + lien vers la page du projet #}
        <h2>
          <a href="{{ ('/projets/' + projet.id + '/') | url }}">{{ projet.title }}</a>
        </h2>

        {# Type de mandat #}
        <p>{{ projet.mandate }}</p>

        {# Sessions (tableau de strings) #}
        {% if projet.sessions and projet.sessions.length %}
          <p>Sessions : {{ projet.sessions | join(', ') }}</p>
        {% endif %}

        {# Client·e·s (tableau de strings) #}
        {% if projet.clients and projet.clients.length %}
          <p>Client·e·s : {{ projet.clients | join(', ') }}</p>
        {% endif %}

        {# Tags (tableau de strings) #}
        {% if projet.tags and projet.tags.length %}
          <ul class="tags">
            {% for tag in projet.tags %}
              <li>{{ tag }}</li>
            {% endfor %}
          </ul>
        {% endif %}

        {# Description #}
        <p>{{ projet.description }}</p>

        {# Compétences mises en œuvre #}
        {% if projet.skills %}
          <p>Compétences : {{ projet.skills }}</p>
        {% endif %}

        {# Autres images (tableau de {fichier, legend}) #}
        {% if projet.images and projet.images.length %}
          <ul class="images">
            {% for image in projet.images %}
              <li>
                <figure>
                  <img src="{{ image.fichier }}" alt="{{ image.legend or '' }}">
                  {% if image.legend %}
                    <figcaption>{{ image.legend }}</figcaption>
                  {% endif %}
                </figure>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        {# Liens (tableau de {label, url}) #}
        {% if projet.links and projet.links.length %}
          <ul class="liens">
            {% for link in projet.links %}
              <li>
                <a href="{{ link.url }}" target="_blank">{{ link.label }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

      </article>
    {% endfor %}
  </section>
{% endif %}

{# ============================================================
   Exemple : Sections (variable `sections`)
   `sections` est l'objet injecté par src/_data/sections.json
   (variable = objet entier, donc on boucle sur `sections.sections`).
   `hook` et `text` sont du Markdown (widget: markdown dans le CMS),
   on utilise le filtre `markdown` + `safe` pour les convertir en HTML.
   ============================================================ #}
{% if sections.sections and sections.sections.length %}
  <section class="sections">
    {% for section in sections.sections %}
      <article class="section">
        <h2>{{ section.title }}</h2>
        {% if section.author %}
          <p class="auteur">{{ section.author }}</p>
        {% endif %}
        {% if section.hook %}
          <div class="accroche">{{ section.hook | markdown | safe }}</div>
        {% endif %}
        {% if section.text %}
          <div class="texte">{{ section.text | markdown | safe }}</div>
        {% endif %}
      </article>
    {% endfor %}
  </section>
{% endif %}

{# ============================================================
   Exemple : Portfolio (config.portfolio)
   Chaque entrée est soit une image (item.media.fichier),
   soit une phrase/citation (item.quote).
   ============================================================ #}
{% if config.portfolio and config.portfolio.length %}
  <section class="portfolio">
    {% for item in config.portfolio %}
      {% if item.media and item.media.image %}
        <figure>
          <img src="{{ item.media.image }}" alt="{{ item.media.legend or '' }}">
          {% if item.media.legend %}
            <figcaption>{{ item.media.legend }}</figcaption>
          {% endif %}
        </figure>
      {% elif item.quote %}
        <blockquote>
          <p>{{ item.quote }}</p>
        </blockquote>
      {% endif %}
    {% endfor %}
  </section>
{% endif %}
