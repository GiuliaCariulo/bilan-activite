<article class="card-portfolio">
  {% if portfolio.fichier %}
    <figure>
      <img
        src="{{ portfolio.fichier | url }}"
        alt="légende de l'image ou titre du projet"
      >
      {% include portfolio.legende %}
      <figcaption class="legende-portfolio">
        {{ portfolio.legende }}
      </figcaption>
      {% endif %}
    </figure>
  {% endif %}

  {% if portfolio.quote %}
    <p class="card-text">{{ portfolio.quote }}</p>
  {% endif %}
</article>
