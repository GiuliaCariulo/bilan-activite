<article
  class="portfolio-card {% if item.media.image %}porfolio-open-modal{% endif %}"
>
  {% if item.media.image %}
    <figure>
      <img
        src="{{ item.media.image | url }}"
        alt="légende de l'image ou titre du projet"
      />
      {% if item.media.legend %}
        <figcaption class="portfolio-legend">
          <p class="portfolio-card-legend">{{ item.media.legend }}</p>
        </figcaption>
      {% endif %}
    </figure>
  {% elif item.quote %}
    <figure class="portfolio-card-text">
      <p>{{ item.quote }}</p>
    </figure>
  {% endif %}
</article>
